<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/dashboard.css">
  <script src="https://unpkg.com/@phosphor-icons/web@2.0.3"></script>
  <style>
    :root {
      --display-width: <%= display_width %>px;
      --display-height: <%= display_height %>px;
    }
  </style>
</head>
<body class="new-layout">
  <%
    const formatDate = (date) => {
      const d = new Date(date);
      const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
      const dayName = days[d.getDay()];
      const month = months[d.getMonth()];
      const day = d.getDate();
      const year = d.getFullYear();

      // Add ordinal suffix (st, nd, rd, th)
      const getOrdinal = (n) => {
        const s = ['th', 'st', 'nd', 'rd'];
        const v = n % 100;
        return n + (s[(v - 20) % 10] || s[v] || s[0]);
      };

      return `${dayName} ${month} ${getOrdinal(day)}, ${year}`;
    };

  %>

  <!-- Message Board (if exists) -->
  <% if (message && message.text) { %>
  <div class="message-banner">
    <%= message.text %>
  </div>
  <% } %>

  <!-- Main Content: Weather Left, Calendar Right -->
  <div class="main-grid">

    <!-- Weather Section (Left) -->
    <div class="weather-section">
      <%
        const getWeatherIcon = (icon) => {
          const iconMap = {
            'clear-day': 'SUNNY',
            'clear-night': 'CLEAR',
            'partly-cloudy-day': 'PARTLY CLOUDY',
            'partly-cloudy-night': 'PARTLY CLOUDY',
            'cloudy': 'CLOUDY',
            'rain': 'RAINY',
            'snow': 'SNOWY',
            'wind': 'WINDY',
            'fog': 'FOGGY'
          };
          return iconMap[icon] || 'CLEAR';
        };

        const mainLocation = locations[0] || {};
        const precipChance = mainLocation.rain_chance || 0;
      %>

      <!-- Date Header -->
      <div class="weather-date-header">
        <%= formatDate(date) %>
      </div>

      <!-- Current Temp with Icon -->
      <div class="weather-temp-display">
        <div class="temp-huge"><%= Math.round(current_temp_c) %>°</div>
        <div class="weather-icon-text"><%= getWeatherIcon(mainLocation.weather_icon) %></div>
      </div>

      <!-- Feels Like & Precipitation -->
      <div class="weather-meta">
        <span class="feels-like">Feels like <%= Math.round(feels_like_c) %>°</span>
        <% if (precipChance > 0) { %>
        <span class="meta-divider">|</span>
        <span class="precip-info"><%= precipChance %>% chance of rain</span>
        <% } %>
      </div>

      <!-- Weather Description -->
      <% if (mainLocation.description) { %>
      <div class="weather-description">
        <%= mainLocation.description %>
      </div>
      <% } %>

      <!-- Low/High + Wardrobe Box -->
      <div class="wardrobe-box-new">
        <div class="temp-range">
          <span class="temp-low-label">Low <%= Math.round(mainLocation.low_c) %>°</span>
          <span class="temp-divider">|</span>
          <span class="temp-high-label">High <%= Math.round(mainLocation.high_c) %>°</span>
        </div>
        <% if (wardrobe) { %>
        <div class="wardrobe-content">
          <div class="wardrobe-icon">👔</div>
          <div class="wardrobe-text-new"><%= wardrobe %></div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Calendar Section (Right) -->
    <div class="calendar-section">
      <div class="calendar-header">Schedule</div>

      <% if (calendar_events && calendar_events.length > 0) { %>
        <div class="calendar-events">
          <% let lastDayLabel = ''; %>
          <% calendar_events.forEach(event => { %>
            <% if (event.dayLabel && event.dayLabel !== lastDayLabel) { %>
              <div class="day-separator"><%= event.dayLabel %></div>
              <% lastDayLabel = event.dayLabel; %>
            <% } %>
            <div class="event-item">
              <div class="event-time"><%= event.time %></div>
              <div class="event-title"><%= event.title %></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-events">No upcoming events</div>
      <% } %>
    </div>

  </div>

  <!-- Footer -->
  <div class="footer-info">
    <% if (battery_level !== null) { %>
      <div>Battery <%= battery_level %>%</div>
    <% } else { %>
      <div></div>
    <% } %>
    <div>Updated <%= last_updated %></div>
  </div>

</body>
</html>
