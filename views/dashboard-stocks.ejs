<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stocks Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/dashboard.css">
  <link rel="stylesheet" href="/styles/stocks.css">
  <script src="https://unpkg.com/@phosphor-icons/web@2.0.3"></script>
  <style>
    :root {
      --display-width: <%= display_width %>px;
      --display-height: <%= display_height %>px;
    }
  </style>
</head>
<body class="stocks-layout">
  <%
    const formatDate = (date, tz) => {
      const d = new Date(date);

      // Use timezone-aware formatting
      const dayName = d.toLocaleDateString('en-US', { weekday: 'short', timeZone: tz });
      const month = d.toLocaleDateString('en-US', { month: 'short', timeZone: tz });
      const day = parseInt(d.toLocaleDateString('en-US', { day: 'numeric', timeZone: tz }), 10);
      const year = d.toLocaleDateString('en-US', { year: 'numeric', timeZone: tz });

      // Add ordinal suffix (st, nd, rd, th)
      const getOrdinal = (n) => {
        const s = ['th', 'st', 'nd', 'rd'];
        const v = n % 100;
        return n + (s[(v - 20) % 10] || s[v] || s[0]);
      };

      return `${dayName} ${month} ${getOrdinal(day)}, ${year}`;
    };

  %>

  <!-- Date Header (Full width) -->
  <div class="page-header">
    <div><%= formatDate(date, timezone) %></div>
    <div>Updated <%= last_updated %></div>
  </div>

  <!-- Main Content: Three Column Layout -->
  <div class="main-grid">

    <!-- Birth Chart Column (Left) -->
    <div class="chart-column">
      <% if (vedicAstrology && vedicAstrology.chartSvg) { %>
        <div class="birth-chart">
          <%- vedicAstrology.chartSvg %>
        </div>
      <% } %>
    </div>

    <!-- Vedic Astrology Data Column (Middle) -->
    <div class="vedic-section">
      <% if (vedicAstrology) { %>

        <!-- Panchang (Daily Elements) - TEMPORARILY HIDDEN -->
        <% if (false && vedicAstrology.panchang) { %>
          <div class="panchang-container">
            <div class="vedic-section-title">Today's Panchang</div>
            <div class="panchang-grid">
              <div class="panchang-item">
                <span class="panchang-label">Vara</span>
                <span class="panchang-value"><%= vedicAstrology.panchang.vara %></span>
              </div>
              <div class="panchang-item">
                <span class="panchang-label">Tithi</span>
                <span class="panchang-value"><%= vedicAstrology.panchang.tithi %></span>
              </div>
              <div class="panchang-item">
                <span class="panchang-label">Nakshatra</span>
                <span class="panchang-value"><%= vedicAstrology.panchang.nakshatra %></span>
              </div>
              <div class="panchang-item">
                <span class="panchang-label">Yoga</span>
                <span class="panchang-value"><%= vedicAstrology.panchang.yoga %></span>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Current Dasha -->
        <% if (vedicAstrology.dasha) { %>
          <div class="vedic-dasha">
            <div class="vedic-section-title">Current Dasha</div>
            <div class="dasha-content">
              <div class="dasha-planet"><%= vedicAstrology.dasha.mahadasha %> - <%= vedicAstrology.dasha.antardasha %></div>
              <div class="dasha-ends">Until <%= vedicAstrology.dasha.mahadashaEnd %></div>
            </div>
          </div>
        <% } %>

        <!-- Muhurta Times - TEMPORARILY HIDDEN -->
        <% if (false && vedicAstrology.panchang) { %>
          <div class="muhurta-container">
            <div class="vedic-section-title">Avoid (Muhurta)</div>
            <div class="muhurta-grid">
              <div class="muhurta-item">
                <span class="muhurta-label">Rahu Kalam</span>
                <span class="muhurta-value"><%= vedicAstrology.panchang.rahuKalam %></span>
              </div>
              <div class="muhurta-item">
                <span class="muhurta-label">Yamaghanda</span>
                <span class="muhurta-value"><%= vedicAstrology.panchang.yamaghanda %></span>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Daily Prediction -->
        <% if (vedicAstrology.prediction && vedicAstrology.prediction.text) { %>
          <div class="vedic-predictions">
            <div class="vedic-section-title">Daily Prediction</div>
            <div class="predictions-list">
              <div class="prediction-item general">
                <div class="prediction-text"><%= vedicAstrology.prediction.text %></div>
              </div>
              <% if (vedicAstrology.prediction.mood || vedicAstrology.prediction.luckyColor || vedicAstrology.prediction.luckyNumber) { %>
                <div class="prediction-extras">
                  <% if (vedicAstrology.prediction.mood) { %>
                    <span class="prediction-extra"><strong>Mood:</strong> <%= vedicAstrology.prediction.mood %></span>
                  <% } %>
                  <% if (vedicAstrology.prediction.luckyColor) { %>
                    <span class="prediction-extra"><strong>Lucky Color:</strong> <%= vedicAstrology.prediction.luckyColor %></span>
                  <% } %>
                  <% if (vedicAstrology.prediction.luckyNumber) { %>
                    <span class="prediction-extra"><strong>Lucky Number:</strong> <%= vedicAstrology.prediction.luckyNumber %></span>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

      <% } else { %>
        <div class="vedic-unavailable">
          <p>Vedic astrology data unavailable</p>
          <p class="vedic-hint">Configure API credentials in .env</p>
        </div>
      <% } %>
    </div>

    <!-- Stocks Section (Right) -->
    <div class="stocks-section">
      <!-- Stock Cards -->
      <% if (stocks && stocks.length > 0) { %>
      <div class="stocks-grid">
        <% stocks.forEach(stock => { %>
        <div class="stock-card">
          <div class="stock-header">
            <div class="stock-symbol-group">
              <span class="stock-symbol"><%= stock.symbol %></span>
              <% if (stock.type === 'crypto') { %>
              <span class="stock-badge crypto-badge">CRYPTO</span>
              <% } %>
            </div>
            <div class="stock-change <%= stock.direction %>">
              <i class="ph-bold <%= stock.direction === 'up' ? 'ph-caret-up' : 'ph-caret-down' %>"></i>
              <%= stock.changePercent %>
            </div>
          </div>
          <div class="stock-price-row">
            <div class="stock-price">$<%= stock.price %></div>
            <div class="stock-change-abs <%= stock.direction %>"><%= stock.change %></div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="no-stocks">
        <p>No stocks configured</p>
        <p class="no-stocks-hint">Visit the admin page to add symbols</p>
      </div>
      <% } %>
    </div>

  </div>

</body>
</html>
