# ===== Multi-Dashboard Configuration =====
# This system supports multiple dashboards with different configurations.
# Each dashboard is defined in config/dashboards.js and can have its own services.
#
# Available dashboard types:
#   - weather: Weather dashboard with forecast, calendar, vehicle info
#   - stocks: Stock/crypto prices with optional calendar
#
# Configure each dashboard's environment variables using the format:
#   <DASHBOARD_ID>_<SETTING>=value

# ===== Dashboard: chripro (Weather Dashboard) =====
# Location ZIP code (5-digit US ZIP) - REQUIRED for weather dashboard
CHRIPRO_LOCATION_ZIP=94607

# Additional location ZIP codes (up to 3, comma-separated)
CHRIPRO_ADDITIONAL_LOCATION_ZIPS=10001,94102,90210

# ===== Dashboard: ro (Stocks Dashboard) =====
# Stock symbols are configured via the admin page at /stocks-admin/ro
# No environment variables needed - uses Yahoo Finance API (free, no key required)

# ===== Stock & Crypto Service (Yahoo Finance) =====
# The stock service fetches real-time prices using Yahoo Finance API
# No API key required - completely free!
#
# Supported formats:
#   Stocks: Use ticker symbol (AAPL, GOOGL, MSFT, TSLA, etc.)
#   Crypto: Use format SYMBOL-USD (BTC-USD, ETH-USD, DOGE-USD, etc.)
#
# Configuration:
#   - Symbols are managed via the admin page: /stocks-admin/<dashboard-id>
#   - Data is cached for 5 minutes to reduce API calls
#   - Includes 5-day sparkline data for visualization
#
# Example symbols:
#   AAPL, GOOGL, MSFT, TSLA (stocks)
#   BTC-USD, ETH-USD, DOGE-USD (crypto)

# ===== Weather Configuration =====
# Visual Crossing Weather API key for forecast data (REQUIRED)
# Get your free API key from: https://www.visualcrossing.com/weather-api
VISUAL_CROSSING_API_KEY=your_visual_crossing_api_key_here

# Personal Weather Station (Optional - leave blank to use Visual Crossing for current conditions)
# Get these from: https://ambientweather.net/account
# AMBIENT_APPLICATION_KEY=your_ambient_application_key_here
# AMBIENT_API_KEY=your_ambient_api_key_here
# AMBIENT_DEVICE_MAC=your_device_mac_address_here (optional, auto-discovers if not set)

# ===== Google Calendar OAuth (Optional) =====
# Each dashboard can have its own Google Calendar account
# Get these from Google Cloud Console: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:7272/auth/google/callback
#
# Per-dashboard authentication files:
#   - chripro dashboard: data/auth-chripro.json
#   - ro dashboard: data/auth-ro.json
# Authenticate each dashboard separately using the /auth route

# ===== Smartcar Vehicle Integration (Optional) =====
# Get these from Smartcar Developer Dashboard: https://dashboard.smartcar.com/
# SMARTCAR_CLIENT_ID=your_smartcar_client_id_here
# SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret_here
# SMARTCAR_REDIRECT_URI=http://localhost:7272/auth/smartcar/callback
# SMARTCAR_MODE=live  # Use 'test' for development, 'live' for production

# ===== LLM Integration (Optional) =====
# Use either Google Gemini (FREE tier) or Anthropic Claude (paid)
# Only one API key is needed - Gemini is recommended for free tier

# Google Gemini API (FREE - Recommended)
# Get your free API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1500 RPD, 1M requests/month
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (Paid alternative)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Server Configuration =====
# Port for the Express server (default: 7272)
PORT=7272

# Data directory path (default: ./data)
DATA_DIR=./data

# ===== E-Paper Display Configuration =====
# Display dimensions in pixels (default: 800x480 for 7.5" display)
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
